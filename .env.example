# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------
# Server
PORT=5000
NODE_ENV=development
# Comma separated list of allowed browser origins. Leave empty to reflect the
# request origin (useful for local development).
CLIENT_URL=http://localhost:3000

# Database (required to start the server)
MONGO_URI=mongodb://127.0.0.1:27017/express-store

# Auth (required; use a long random string)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=1d

# Password reset e-mail / SMTP
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_FROM="Express Store" <no-reply@example.com>
# Base URL used to build the reset-password link in the e-mail
APP_URL=http://localhost:3000

# Optional absolute URL advertised in the Swagger/OpenAPI `servers` list.
# Leave unset to use the current host (recommended for Vercel previews).
# API_BASE_URL=https://api.example.com

# Endpoint used by `npm run health` (defaults to http://127.0.0.1:PORT/api/health/ready)
# HEALTHCHECK_URL=https://api.example.com/api/health/ready

# Cloudinary (image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# PayPal (sandbox | live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
